<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CrossBrowserSuite">

    <listeners>
        <listener class-name="org.example.listeners.ExtentListener"/>
    </listeners>

    <parameter name="browser" value="firefox"/>
    <parameter name="os" value="windows"/>

    <test name="ChromeTests">
        <classes>
            <class name="org.example.testCases.TC001_AccountRegistrationTest"/>
            <class name="org.example.testCases.TC002_LoginTest"/>
            <class name="org.example.testCases.TC003_ProductSearch"/>
            <class name="org.example.testCases.TC004_RegistrationValidationTest"/>
        </classes>
    </test>

</suite>