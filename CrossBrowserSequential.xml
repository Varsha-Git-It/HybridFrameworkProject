<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SequentialCrossBrowserSuite">

    <listeners>
        <listener class-name="org.example.listeners.ExtentListener"/>
    </listeners>

    <test name="ChromeTests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="org.example.testCases.TC001_AccountRegistrationTest"/>
            <class name="org.example.testCases.TC002_LoginTest"/>
            <class name="org.example.testCases.TC003_ProductSearch"/>
            <class name="org.example.testCases.TC004_RegistrationValidationTest"/>
        </classes>
    </test>

    <test name="FirefoxTests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="org.example.testCases.TC001_AccountRegistrationTest"/>
            <class name="org.example.testCases.TC002_LoginTest"/>
            <class name="org.example.testCases.TC003_ProductSearch"/>
            <class name="org.example.testCases.TC004_RegistrationValidationTest"/>
        </classes>
    </test>

    <test name="EdgeTests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="org.example.testCases.TC001_AccountRegistrationTest"/>
            <class name="org.example.testCases.TC002_LoginTest"/>
            <class name="org.example.testCases.TC003_ProductSearch"/>
            <class name="org.example.testCases.TC004_RegistrationValidationTest"/>
        </classes>
    </test>

</suite>